# Application
JWT_SECRET=replace_with_a_long_random_secret
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt
ALLOWED_ORIGINS=http://localhost:5173
# Fail fast beyond this many concurrent pipelines per backend replica.
VOICE_MAX_CONCURRENT_SESSIONS=8

# WebRTC connectivity. Use short-lived TURN credentials in production.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_AUDIO_ECHO_CANCELLATION=true
VITE_AUDIO_NOISE_SUPPRESSION=true
VITE_AUDIO_AUTO_GAIN_CONTROL=true
VITE_LOCAL_SPEECH_LEVEL_THRESHOLD=0.01

# Database
DATABASE_URL=postgresql+asyncpg://pipecat_user:pipecat_password@postgres:5432/pipecat_db
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
DB_VOICE_POOL_SIZE=10
DB_VOICE_MAX_OVERFLOW=0
DB_VOICE_POOL_TIMEOUT=1.0
DB_VOICE_STATEMENT_TIMEOUT_MS=2000
DB_VOICE_HNSW_ITERATIVE_SCAN=relaxed_order
DB_VOICE_HNSW_MAX_SCAN_TUPLES=10000

# LLM: google | groq | openai (exactly one provider per voice pipeline)
LLM_PROVIDER=google

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_THINKING_LEVEL=minimal
VOICE_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=5
VOICE_LLM_TIMEOUT_MESSAGE=I'm having trouble reaching the language service. Please try that again.

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MEMORY_MODEL=llama-3.1-8b-instant

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MEMORY_MODEL=gpt-4.1-mini

# Speech-to-text: deepgram
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_RECONNECT_BUFFER_MAX_BYTES=256000
STT_CONNECT_TIMEOUT_SECONDS=5

# Text-to-speech: deepgram | cartesia | piper
TTS_PROVIDER=deepgram
# auto uses token streaming for remote providers and sentence mode for Piper.
TTS_TEXT_AGGREGATION_MODE=auto
DEEPGRAM_VOICE_ID=aura-2-thalia-en
TTS_TRIM_LEADING_SILENCE=true
TTS_SILENCE_THRESHOLD=128
TTS_SILENCE_PREROLL_MS=20
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
# PIPER_VOICE_ID=

# Web search tools
TAVILY_API_KEY=

# Voice latency and retrieval tuning
# Tune endpointing against recorded audio from your environment.
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.15
VAD_STOP_SECS=0.15
VAD_MIN_VOLUME=0.5
SMART_TURN_STOP_SECS=0.6
SMART_TURN_PRE_SPEECH_MS=300
SMART_TURN_MAX_DURATION_SECS=8
VOICE_CONTEXT_MAX_MESSAGES=24
VOICE_CONTEXT_MAX_CHARS=18000
VOICE_GREETING_TEXT=Hello! How can I help?
VOICE_TOOL_TIMEOUT_SECONDS=5
VOICE_TOOL_FILLER_DELAY_MS=350
AUDIO_OUT_10MS_CHUNKS=1
AUDIO_INPUT_SAMPLE_RATE=16000
# Defaults to 24 kHz for remote TTS and 22050 Hz for the bundled Piper model.
# AUDIO_OUTPUT_SAMPLE_RATE=24000
RAG_VOICE_RETRIEVAL_TIMEOUT_SECONDS=2.5
RAG_RESULT_CACHE_SIZE=256
RAG_RESULT_CACHE_TTL_SECONDS=120
RAG_INGEST_EMBED_CONCURRENCY=4
MEMORY_EMBEDDING_CACHE_SIZE=256
MEMORY_EMBEDDING_CACHE_TTL_SECONDS=300
MEMORY_PROMPT_MAX_TOKENS=3000

# Optional memory and RAG configuration
# MEMORY_EMBEDDING_PROVIDER=google
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_MEMORY_MODEL=gemini-2.5-flash

# Alternative OpenAI memory and embedding provider
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_MEMORY_MODEL=gpt-4o-mini

# MEMORY_PROMPT_FILE=prompts/memory_prompt.txt
# MEMORY_VECTOR_DB=pgvector
# RAG_UPLOAD_DIR=uploads
# RAG_SMART_ROUTER=true
# RAG_RERANKER=true
