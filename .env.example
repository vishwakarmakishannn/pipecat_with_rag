# Authentication
JWT_SECRET=your_secure_jwt_secret_here

# Database
DATABASE_URL=postgresql+asyncpg://pipecat_user:pipecat_password@postgres:5432/pipecat_db

# Providers (Set the ones you need)
# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=

# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=

# Latency tuning
SMART_TURN_STOP_SECS=1.5
AUDIO_OUT_10MS_CHUNKS=2
RAG_VOICE_RETRIEVAL_TIMEOUT_SECONDS=2.5
RAG_INGEST_EMBED_CONCURRENCY=4
MEMORY_EMBEDDING_CACHE_SIZE=256
MEMORY_EMBEDDING_CACHE_TTL_SECONDS=300
